# Copy this file to .env and paste your own API key after the equals sign.
DIARY_API_KEY=
DIARY_MODEL=gpt-4o-mini
DIARY_IMAGE_MODEL=gpt-image-2.5-sunburst
DIARY_VERIFY_MODEL=gpt-4o-mini
DIARY_IMAGE_QUALITY=medium
# local is the main verifier; api is an explicit comparison baseline.
DIARY_VERIFY_BACKEND=local
# Set after training and starting: python -m diary_verifier.fusion_serve --checkpoint ... --port 8010
DIARY_VERIFIER_URL=
# Auto-check newly generated pictures. API mode only auto-checks if explicitly true.
DIARY_VERIFY_AUTO=true
PORT=3000
